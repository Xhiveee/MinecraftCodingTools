{
  "name": "minecraft-coding-tools",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/release.test.mjs test/stonecutter.test.mjs",
    "release": "npm run build && node scripts/release.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "adm-zip": "^0.6.1",
    "fast-xml-parser": "^5.11.2",
    "java-parser": "^3.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "displayName": "MinecraftCodingTools",
  "description": "MCP server for Minecraft mod and plugin development.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Xhiveee/MinecraftCodingTools.git"
  },
  "homepage": "https://github.com/Xhiveee/MinecraftCodingTools",
